{
  "name": "kamplex-api",
  "version": "0.0.1",
  "description": "REST API media streaming",
  "author": "Kaigonia <ktt45678@gmail.com> (https://github.com/ktt45678)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@azure/storage-blob": "12.34.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.8",
    "@keyv/redis": "5.1.6",
    "@nestjs/axios": "12.0.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/cache-manager": "12.0.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-fastify": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/websockets": "12.3.2",
    "@socket.io/redis-adapter": "8.3.0",
    "axios": "1.21.0",
    "bcrypt": "6.0.0",
    "bullmq": "6.5.0",
    "cache-manager": "7.2.9",
    "cacheable": "2.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fast-average-color": "9.6.0",
    "fastify": "5.12.7",
    "file-type": "22.2.0",
    "form-data": "4.0.6",
    "ioredis": "6.0.0",
    "iso-639-1": "3.1.6",
    "keyv": "5.6.0",
    "lodash": "4.18.1",
    "mime-types": "3.0.2",
    "mongodb": "7.7.0",
    "mongoose": "9.11.4",
    "nanoid": "6.0.2",
    "p-limit": "7.3.3",
    "parse-redis-url-simple": "1.0.2",
    "reflect-metadata": "0.2.2",
    "remove-accents": "0.5.0",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "slugify": "1.6.9",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/bcrypt": "6.0.0",
    "@types/busboy": "1.5.5",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/validator": "13.15.10",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "optionalDependencies": {
    "bufferutil": "4.0.8",
    "utf-8-validate": "6.0.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "node"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "bufferutil@4.0.8": true,
    "msgpackr-extract@3.0.2": true,
    "sharp@0.32.6": true
  }
}
